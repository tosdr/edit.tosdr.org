<% content_for :title do %>
  <title>Cases</title>
<% end %>

<div id="dynamic-cases-table" v-cloak>
  <div class="card-inline">
    <div class="card-inline-item card-inline-service">
      <div class="row">
        <div class="col-lg-6">
          <h1>Cases</h1>
        </div>
      </div>
      <br>
      <br>
      <div class="row">
        <div class="col-lg-6">
          <%= render "shared/search_vue" %>
          <div class="mt-2">
            <span class="text-muted" style="font-size: small;">
              Search by case or topic title
            </span>
          </div>
        </div>

        <div class="col-lg-6 text-right justify-content-end">
          <% if current_user&.curator %>
            <%= link_to 'Add Case', new_case_path, class: 'btn btn-primary smaller-btn-text' %>
          <% end %>
        </div>
      </div>
      <br>
      <div class="loading" v-if="loading">
        Loading...
      </div>
      <div v-else>
        <p v-if="groupedCases.length === 0">No cases match your search.</p>
        <div v-for="group in groupedCases" :key="group.key" class="mb-4">
          <h2 class="h4">
            <a v-if="group.topic" v-bind:href="'/topics/' + group.topic.id">{{ group.topic.title }}</a>
            <span v-else>No topic</span>
          </h2>
          <div class="table-responsive">
            <table class="table table-striped">
              <thead>
                <tr>
                  <th scope="col">Title</th>
                  <th scope="col" class="text-right" style="width: 10%;" title="Points of any status, excluding deleted">Points</th>
                  <th scope="col" class="text-right" style="width: 10%;">Approved</th>
                  <th scope="col" class="text-right" style="width: 10%;">Weight</th>
                  <th scope="col" style="width: 10%;">Rating</th>
                </tr>
              </thead>
              <tbody>
                <tr v-for="c in group.cases" :key="c.case.id">
                  <td v-bind:title="c.case.description"><a v-bind:href="'/cases/' + c.case.id">{{ c.case.title }}</a></td>
                  <td class="text-right">{{ c.points_count }}</td>
                  <td class="text-right"><a v-bind:href="'/cases/' + c.case.id + '?status=approved'" title="View approved points">{{ c.approved_points_count }}</a></td>
                  <td class="text-right">{{ c.case.score }}</td>
                  <td><div v-bind:class="c.pointbox"></div></td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
